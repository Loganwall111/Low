			],
			"animations": [
				{
					"var.wasdead": " if(nbt(PlayDeadManager.State,2),1,if(var.wasdead==0,0,var.wasdead))",
					"var.wasalive": "if(nbt(PlayDeadManager.State,range:0-1),1,if(var.wasalive==0,0,var.wasalive))"
				},
				{
					"var.debrisr": "if(round(random(id))==0,-1,1)",
					"debris.sx": "2.0",
					"debris.sy": "debris.sx",
					"debris.sz": "debris.sx"
				},
				{
					"debris.ry": "torad(fmod(age*var.debrisr*0,360))-rot_y",
					"debris.rx": "sin(age*var.debrisr*0.0)*0.0",
					"debris_A.ry": "sin(age*var.debrisr*0.0)*0.0",
					"debris_A.rx": "torad(fmod(age*var.debrisr*7,360))",
					"debris_B.ry": "-sin(age*var.debrisr*0.0)*0.0",
					"debris_B.rx": "-torad(fmod(age*var.debrisr*6,360))",
					"debris_C.ry": "sin(age*var.debrisr*0.0)*0.0",
					"debris_C.rx": "torad(fmod(age*var.debrisr*8,360))",
					"var.playdead": "clamp(if(nbt(PlayDeadManager.State,2), if(var.wasalive==1,var.playdead + 0.2*frame_time * if(is_paused,0,1),1),if(var.wasdead==1,var.playdead - 0.08*frame_time * if(is_paused,0,1),0)),0,1)",
					"var.falling": "clamp(var.falling + if(var.y-pos_y>50*frame_time && nbt(PlayDeadManager.State,1),0.45*frame_time,-0.2*frame_time) * if(is_paused,0,1),0,1)"
				},
				{
					"base.rx": "0",
					"base.ry": "0",
					"base.rz": "0",
					"tentacles_.sx": "0.7",
					"tentacles_.sy": "tentacles_.sx",
					"tentacles_.sz": "tentacles_.sx",
					"var.div1": "1.4",
					"var.div2": "1",
					"var.tsf": "0.00110",
					"var.speed1": "3.15",
					"debris_A.visible": "var.playdead<0.25",
					"debris_B.visible": "var.playdead<0.3",
					"debris_C.visible": "var.playdead<0.15"
				},
