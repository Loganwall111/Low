			"animations": [
				{
					"var.wasdead": " if(nbt(PlayDeadManager.State,2),1,if(var.wasdead==0,0,var.wasdead))",
					"var.wasalive": "if(nbt(PlayDeadManager.State,range:0-1),1,if(var.wasalive==0,0,var.wasalive))"
				},
				{
					"base.rx": "0",
					"base.ry": "0",
					"base.rz": "0",
					"debris.sx": "3.0",
					"debris.sy": "debris.sx",
					"debris.sz": "debris.sx",
					"tentacles_.sx": "0.7",
					"tentacles_.sy": "tentacles_.sx",
					"tentacles_.sz": "tentacles_.sx",
					"var.div1": "1.4",
					"var.div2": "1",
					"var.speed1": "3.15",
					"var.tsf": "0.00120",
					"var.bsf": "1.95"
				},
				{
					"var.debrisr": "if(round(random(id))==0,-1,1)"
				},
				{
					"debris2.ry": "sin(age*var.debrisr*0)*0",
					"debris2.rx": "torad(fmod(age*var.debrisr*8,360))",
					"debris2.visible": "var.playdead<0.25",
					"var.playdead": "clamp(if(nbt(PlayDeadManager.State,2), if(var.wasalive==1,var.playdead + 0.2*frame_time * if(is_paused,0,1),1),if(var.wasdead==1,var.playdead - 0.08*frame_time * if(is_paused,0,1),0)),0,1)",
					"var.falling": "clamp(var.falling + if(var.y-pos_y>50*frame_time && nbt(PlayDeadManager.State,1),0.45*frame_time,-0.2*frame_time) * if(is_paused,0,1),0,1)"
